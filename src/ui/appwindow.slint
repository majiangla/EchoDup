            MyMenuItemBase {
                entry: { title: "复制音频 (Ctrl+X)", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 1;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.copy-current-audio(); }
            }
            MyMenuItemBase {
                entry: { title: "", shortcut: "", enabled: true, checked: false, is-separator: true };
                index: 2;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
            }
            MyMenuItemBase {
                entry: { title: "全选 (Ctrl+A)", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 3;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.select-all-current(); }
            }
            MyMenuItemBase {
                entry: { title: "取消全选", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 4;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.select-none-current(); }
            }
            MyMenuItemBase {
                entry: { title: "反选 (Ctrl+Shift+I)", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 5;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.invert-current(); }
            }
        }
    }

    // 查看（一级：三个子菜单入口）
    if root.menu-open == 2: Rectangle {
        x: mb-view.x + menu-buttons.x;
        y: 40px;
        width: 150px;
        height: menu-frame-view.preferred-height;
        background: root.dark-mode ? #23262b : #ffffff;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.dark-mode ? #00000040 : #00000012;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        menu-frame-view := MyMenuFrameBase {
