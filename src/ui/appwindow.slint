                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.sub-open = 1; }
            }
            MyMenuItemBase {
                entry: { title: "字号", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 2;
                font-size: 13px;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.sub-open = 2; }
            }
        }
    }

    // 查看二级：ASR 内容分行
    if root.menu-open == 2 && root.sub-open == 0: Rectangle {
        x: mb-view.x + menu-buttons.x + 150px;
        y: 41px;
        width: menu-frame-asr.preferred-width;
        height: menu-frame-asr.preferred-height;
        background: root.dark-mode ? #23262b : #ffffff;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.dark-mode ? #00000040 : #00000012;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        menu-frame-asr := MyMenuFrameBase {
            margin: 1px;
            layout-min-width: 300px;
            MyMenuItemBase {
                entry: { title: "按句号分行", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 0;
                font-size: 13px;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.set-split-mode(0); }
            }
            MyMenuItemBase {
                entry: { title: "按换行分行", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 1;
                font-size: 13px;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.set-split-mode(1); }
            }
            MyMenuItemBase {
                entry: { title: "按原文 M:/W: 分行", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 2;
                font-size: 13px;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.set-split-mode(2); }
            }
        }
    }

    // 查看二级：字体
    if root.menu-open == 2 && root.sub-open == 1: Rectangle {
        x: mb-view.x + menu-buttons.x + 150px;
        y: 41px + 26px;
        width: menu-frame-fonts.preferred-width;
        height: min(420px, menu-frame-fonts.preferred-height);
        background: root.dark-mode ? #23262b : #ffffff;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.dark-mode ? #00000040 : #00000012;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        ScrollView {
            width: 100%;
            height: 100%;
            menu-frame-fonts := MyMenuFrameBase {
            margin: 1px;
            layout-min-width: 300px;
            MyMenuItemBase {
                entry: { title: "Times New Roman", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 0;
                font-size: 13px;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.text-font = "Times New Roman"; }
            }
            MyMenuItemBase {
                entry: { title: "宋体", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 1;
                font-size: 13px;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.text-font = "SimSun"; }
            }
            MyMenuItemBase {
                entry: { title: "微软雅黑", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 2;
                font-size: 13px;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.text-font = "Microsoft YaHei"; }
            }
            MyMenuItemBase {
                entry: { title: "等宽", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 3;
                font-size: 13px;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.text-font = "monospace"; }
            }
            MyMenuItemBase {
                entry: { title: "", shortcut: "", enabled: true, checked: false, is-separator: true };
                index: 4;
                font-size: 13px;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
            }
            for f in root.sys-fonts: MyMenuItemBase {
                entry: { title: f, shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 5;
                font-size: 13px;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.text-font = f; }
            }
        }
        }
    }

    // 查看二级：字号
    if root.menu-open == 2 && root.sub-open == 2: Rectangle {
        x: mb-view.x + menu-buttons.x + 150px;
        y: 41px + 52px;
        width: menu-frame-size.preferred-width;
        height: menu-frame-size.preferred-height;
        background: root.dark-mode ? #23262b : #ffffff;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.dark-mode ? #00000040 : #00000012;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        menu-frame-size := MyMenuFrameBase {
            margin: 1px;
            layout-min-width: 300px;
            for sz in [10, 11, 12, 13, 14, 15, 16, 18, 20, 24, 28, 36]: MyMenuItemBase {
                entry: { title: sz + "px", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 0;
                font-size: 13px;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.text-size = sz * 1px; }
            }
        }
    }

    // 帮助
    if root.menu-open == 3: Rectangle {
        x: mb-help.x + menu-buttons.x;
        y: 40px;
        width: menu-frame-help.preferred-width;
        height: menu-frame-help.preferred-height;
        background: root.dark-mode ? #23262b : #ffffff;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.dark-mode ? #00000040 : #00000012;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        menu-frame-help := MyMenuFrameBase {
            margin: 1px;
            layout-min-width: 300px;
            MyMenuItemBase {
                entry: { title: "快捷键说明 (Ctrl+H)", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 0;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.open-help(); }
            }
        }
    }

    // 关于
    if root.menu-open == 4: Rectangle {
        x: mb-about.x + menu-buttons.x;
        y: 40px;
        width: menu-frame-about.preferred-width;
        height: menu-frame-about.preferred-height;
        background: root.dark-mode ? #23262b : #ffffff;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.dark-mode ? #00000040 : #00000012;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        menu-frame-about := MyMenuFrameBase {
            margin: 1px;
            layout-min-width: 300px;
            MyMenuItemBase {
                entry: { title: "哔哩哔哩 (Ctrl+Q)", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 0;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.about(); }
            }
            MyMenuItemBase {
                entry: { title: "抖音", shortcut: "", enabled: true, checked: false, is-separator: false };
                index: 1;
                default-foreground: root.dark-mode ? #ffffff : #000000;
                current-foreground: root.dark-mode ? #ffffff : #000000;
                current-background: root.dark-mode ? #FFFFFF0F : #0000000A;
                separator-color: root.dark-mode ? #ffffff18 : #00000014;
                activate => { root.close-menus(); root.about-douyin(); }
            }
        }
    }

}
// ============================================================
// 快捷键说明子窗口：独立窗口，非模态，出现时主窗口仍可操作
// ============================================================
export component HelpWindow inherits Window {
    title: "快捷键说明";
    preferred-width: 430px;
    preferred-height: 620px;

    background: Palette.color-scheme == ColorScheme.dark ? #1f2227 : #f6f7f9;

    VerticalLayout {
        padding: 16px;
        spacing: 4px;

        Text {
            text: "快捷键说明";
            font-weight: 700;
            font-size: 16px;
            color: Palette.color-scheme == ColorScheme.dark ? #e6e8ec : #1f2328;
        }
        Rectangle {
            height: 1px;
            background: Palette.color-scheme == ColorScheme.dark ? #33373f : #e3e6ea;
        }
        Text { text: "空格  播放 / 暂停"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "↑ / ↓  切换上一个 / 下一个 Text"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "← / →（PgUp / PgDn）  切换上一句 / 下一句"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "1-9 / 0  播放第 1-10 个 Text"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "C / X  加速 / 减速 0.1"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "Z  恢复 1 倍速"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "Ctrl + ±  倍速步进 0.1"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "Ctrl + O  打开文件"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "Ctrl + S  导出当前 Text 音频"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "Ctrl + C  复制当前句音频"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "Ctrl + X  复制当前句文本"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "Ctrl + A  全选当前 Text"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "Ctrl + Shift + I  反选当前 Text"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "Ctrl + R / F5  按当前参数重新分析对齐"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "Ctrl + Q  关于（哔哩哔哩）"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: "Ctrl + H  本快捷键说明"; color: Palette.color-scheme == ColorScheme.dark ? #c3c9d2 : #333333; font-size: 12px; }
        Text { text: ""; font-size: 4px; }
        Button {
            text: "关闭";
            clicked => { root.close(); }
        }
    }
}
